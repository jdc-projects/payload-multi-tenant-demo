{
  "name": "@demo/cms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "payload generate:importmap && prettier --write 'src/app/(payload)/admin/importMap.js' && payload generate:types && next build --webpack",
    "dev": "tsx ../../scripts/run-next.ts cms dev",
    "start": "tsx ../../scripts/run-next.ts cms start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@payloadcms/db-postgres": "^3",
    "@payloadcms/next": "^3",
    "@payloadcms/richtext-lexical": "^3",
    "@payloadcms/storage-s3": "^3",
    "graphql": "^16",
    "next": "^16",
    "payload": "^3",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5",
    "vitest": "^4"
  }
}
