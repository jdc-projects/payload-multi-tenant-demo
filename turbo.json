{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PAYLOAD_SECRET",
    "DATABASE_URL",
    "POSTGRES_PROTOCOL",
    "POSTGRES_HOST",
    "POSTGRES_PORT",
    "POSTGRES_DB",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "S3_ENDPOINT",
    "S3_PROTOCOL",
    "S3_HOST",
    "S3_PORT",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "NEXT_PUBLIC_CMS_URL",
    "NEXT_PUBLIC_WEB_URL",
    "CMS_PROTOCOL",
    "CMS_HOST",
    "CMS_PORT",
    "WEB_PROTOCOL",
    "WEB_HOST",
    "WEB_PORT",
    "NEXT_DIST_DIR",
    "CMS_RENDERER_TOKEN"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^test"] },
    "test:unit": { "dependsOn": ["^test:unit"] }
  }
}
