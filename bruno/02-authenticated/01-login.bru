meta {
  name: Log in administrator
  type: http
  seq: 1
}

post {
  url: http://localhost:{{proxyPort}}/api/users/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
  res.body.user.email: eq {{adminEmail}}
}

script:post-response {
  bru.setVar("authToken", res.getBody().token);
}
