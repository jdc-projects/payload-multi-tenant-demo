meta {
  name: Scope page query to requested tenant
  type: http
  seq: 4
}

get {
  url: http://localhost:{{proxyPort}}/api/pages?where[and][0][tenant.slug][equals]=demo2&where[and][1][slug][equals]=&depth=2
  body: none
  auth: none
}

headers {
  x-cms-renderer-token: {{rendererToken}}
}

assert {
  res.status: eq 200
  res.body.docs: isArray
  res.body.totalDocs: gt 0
}

tests {
  test("every returned page belongs to demo2", function() {
    const body = res.getBody();
    expect(body.totalDocs).to.be.greaterThan(0);
    expect(body.docs).to.be.an("array").that.is.not.empty;
    expect(body.docs.every((page) => page?.tenant?.slug === "demo2")).to.equal(true);
  });
}
