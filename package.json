{
  "name": "payload-multi-tenant-demo",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run build",
    "build:managed": "tsx scripts/test-stack.ts build",
    "dev": "tsx scripts/watch.ts",
    "dev:infra": "tsx scripts/infra.ts up",
    "start": "npm run dev:infra && node --env-file-if-exists=.env node_modules/turbo/bin/turbo run start --parallel",
    "start:infra": "tsx scripts/infra.ts up",
    "test:stack": "tsx scripts/test-stack.ts",
    "format": "prettier --write .",
    "format:scoped": "prettier --write",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "seed": "npm run seed:cms",
    "seed:cms": "tsx apps/cms/src/seed.ts",
    "seed:export": "tsx apps/cms/src/seed.ts export",
    "seed:import": "tsx apps/cms/src/seed.ts import",
    "test": "npm run test:unit && npm run test:playwright && npm run test:e2e && npm run test:artillery && npm run test:mutation",
    "test:unit": "turbo run test:unit",
    "test:playwright": "playwright test --config=tests/playwright/web.config.ts",
    "test:e2e": "playwright test --config=tests/playwright/e2e.config.ts",
    "test:artillery": "tsx scripts/test-stack.ts artillery",
    "test:mutation": "stryker run",
    "check:react-doctor": "CI=1 react-doctor -y --no-telemetry apps/web/src",
    "check:fallow": "fallow audit",
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run build:managed && npm run check:react-doctor && npm run check:fallow && npm run test"
  },
  "devDependencies": {
    "prettier": "^3",
    "@axe-core/playwright": "^4",
    "@playwright/test": "^1",
    "artillery": "^2",
    "fallow": "^3",
    "react-doctor": "^0",
    "@stryker-mutator/core": "^10",
    "@stryker-mutator/vitest-runner": "^10",
    "tsx": "^4",
    "turbo": "^2"
  }
}
